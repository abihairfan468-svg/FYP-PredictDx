# ---- Server ----
PORT=3000
NODE_ENV=development
# The React dev server origin(s) allowed by CORS, comma-separated
WEB_ORIGIN=http://localhost:5173,http://localhost:5174

# ---- Database: PostgreSQL ----
# By default PredictDx runs its own bundled PostgreSQL server on port 5433 (data in backend/.pgdata).
# To use another PostgreSQL (installed, Docker, Neon/Supabase), change DATABASE_URL and set USE_EMBEDDED_POSTGRES=false.
DATABASE_URL="postgresql://predictdx:predictdx@localhost:5433/predictdx?schema=public"
USE_EMBEDDED_POSTGRES=true

# ---- JWT (generate long random strings for anything shared) ----
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_MFA_SECRET=change-me-mfa-secret-at-least-32-characters
REFRESH_TTL_DAYS=7
OTP_PEPPER=change-me-otp-pepper

# ---- One-time codes ----
# false -> codes only go out by e-mail, never shown on the sign-in screen (real behaviour).
# true  -> the API also returns the code and the screen shows it (offline testing only).
OTP_DEV_ECHO=false

# ---- E-mail. Fill these so codes arrive in the user's real inbox. ----
# If SMTP_HOST is empty, codes are only printed in the API terminal.
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true, SMTP_USER = your Gmail address,
# SMTP_PASS = a Google "App password" (Google Account > Security > 2-Step Verification > App passwords),
# MAIL_FROM="PredictDx <your Gmail address>"
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PredictDx <no-reply@predictdx.com>"

# ---- AI service (module 7.4, in progress) ----
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_KEY=dev-internal-key

# ---- Extra demo accounts (npm --prefix backend run accounts:add) ----
# Set to your Gmail (e.g. yourname@gmail.com): the demo logins become yourname+sara.ahmed@gmail.com etc.,
# so their sign-in codes really arrive in your inbox. Empty = name@predictdx.com (codes in the API console).
DEMO_GMAIL=
