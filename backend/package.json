{
  "name": "predictdx-backend",
  "version": "0.2.0",
  "description": "PredictDx API (NestJS + PostgreSQL) - AI multimodal system for early detection and future risk prediction of chest diseases",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "db:push": "node scripts/with-postgres.mjs npx prisma db push",
    "db:seed": "node scripts/with-postgres.mjs npx ts-node prisma/seed.ts",
    "db:reset": "node scripts/with-postgres.mjs \"npx prisma db push --force-reset && npx ts-node prisma/seed.ts\"",
    "as-doctor": "node scripts/as-doctor.js",
    "setup": "node scripts/init-env.js && node scripts/with-postgres.mjs \"npx prisma db push && npx ts-node prisma/seed.ts\"",
    "test": "jest",
    "test:e2e": "node scripts/with-postgres.mjs jest --config ./test/jest-e2e.json --runInBand",
    "db:server": "node scripts/postgres.mjs",
    "db:studio": "node scripts/with-postgres.mjs npx prisma studio",
    "dataset:export": "node scripts/with-postgres.mjs npx ts-node scripts/export-dataset.ts",
    "xrays:to-db": "node scripts/with-postgres.mjs npx ts-node scripts/move-xrays-to-db.ts",
    "data:sync": "node scripts/with-postgres.mjs npx ts-node scripts/sync-reference-data.ts",
    "accounts:update": "node scripts/with-postgres.mjs npx ts-node scripts/update-accounts.ts",
    "accounts:add": "node scripts/with-postgres.mjs npx ts-node scripts/add-demo-accounts.ts",
    "today": "node scripts/with-postgres.mjs npx ts-node scripts/refresh-today.ts",
    "accounts:real-emails": "node scripts/with-postgres.mjs npx ts-node scripts/use-real-emails.ts",
    "showcase:add": "node scripts/with-postgres.mjs npx ts-node scripts/add-showcase-data.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.0",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "embedded-postgres": "18.4.0-beta.17",
    "helmet": "^8.0.0",
    "multer": "^2.0.0",
    "nodemailer": "^6.9.16",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^6.19.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  }
}
