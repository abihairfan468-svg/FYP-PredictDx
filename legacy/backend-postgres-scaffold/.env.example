# ---- App ----
NODE_ENV=development
PORT=3000

# ---- Database ----
DATABASE_URL="postgresql://predictdx:predictdx@localhost:5432/predictdx?schema=public"

# ---- Redis / queue ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Auth ----
JWT_ACCESS_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-too-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Storage (local disk in dev, MinIO/S3 later) ----
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=predictdx
S3_ACCESS_KEY=predictdx
S3_SECRET_KEY=predictdx123

# ---- AI service ----
AI_SERVICE_URL=http://localhost:8000
INTERNAL_API_KEY=dev-internal-key

# ---- Uploads ----
MAX_UPLOAD_MB=20
